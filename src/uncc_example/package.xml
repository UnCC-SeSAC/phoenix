<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uncc_example</name>
  <version>0.1.0</version>
  <description>
    Frontier exploration for Hiwonder + LD19 using SLAM Toolbox,
    Nav2 costmaps, NavigateToPose, and a semantic hazard map.
  </description>

  <maintainer email="user@example.com">UNCC project</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>nav2_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <exec_depend>interfaces</exec_depend>
  <exec_depend>frontier_exploration_ros2</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>



  <!-- Existing Hiwonder workspace packages -->
  <exec_depend>controller</exec_depend>
  <exec_depend>peripherals</exec_depend>
  <exec_depend>navigation</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
